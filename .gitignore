.dev_run.pid

# Godot 4.5+ UID cache files
*.gd.uid

# GdUnit4 test reports
reports/

# Test credentials (never commit)
.test_credentials

# Game output log
output.log

# OS
.DS_Store
Thumbs.db

# Screenshots from the dev loop and the POI gallery
screenshots/
tmp/
