[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/battle_panel.gd" id="1"]

[node name="BattlePanel" type="PanelContainer"]
script = ExtResource("1")
custom_minimum_size = Vector2(320, 0)
size_flags_vertical = 3

[node name="BattleMargin" type="MarginContainer" parent="."]
theme_override_constants/margin_left = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_top = 8
theme_override_constants/margin_bottom = 8

[node name="BattleLayout" type="VBoxContainer" parent="BattleMargin"]
theme_override_constants/separation = 8

[node name="TitleLabel" type="Label" parent="BattleMargin/BattleLayout"]
text = "⚔ COMBAT"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 16
modulate = Color(1, 0.3, 0.3, 1)

[node name="InfoRow" type="HBoxContainer" parent="BattleMargin/BattleLayout"]
