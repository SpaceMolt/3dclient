[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/ship_panel.gd" id="1"]

[node name="ShipPanel" type="PanelContainer"]
script = ExtResource("1")
custom_minimum_size = Vector2(340, 0)
size_flags_vertical = 3

[node name="Margin" type="MarginContainer" parent="."]
theme_override_constants/margin_left = 8
theme_override_constants/margin_right = 8
theme_override_constants/margin_top = 6
theme_override_constants/margin_bottom = 6

[node name="VBox" type="VBoxContainer" parent="Margin"]
theme_override_constants/separation = 4

[node name="Header" type="HBoxContainer" parent="Margin/VBox"]
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Margin/VBox/Header"]
text = "Ships"
theme_type_variation = &"PanelTitle"

[node name="ShipStatus" type="Label" parent="Margin/VBox/Header"]
unique_name_in_owner = true
size_flags_horizontal = 3
horizontal_alignment = 2
theme_override_font_sizes/font_size = 11
modulate = Color(0.6, 0.6, 0.6, 1)

[node name="ShipTabs" type="TabContainer" parent="Margin/VBox"]
unique_name_in_owner = true
size_flags_vertical = 3

[node name="My Ships" type="ScrollContainer" parent="Margin/VBox/ShipTabs"]
size_flags_vertical = 3

[node name="MyShipsList" type="VBoxContainer" parent="Margin/VBox/ShipTabs/My Ships"]
unique_name_in_owner = true
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="Shipyard" type="ScrollContainer" parent="Margin/VBox/ShipTabs"]
size_flags_vertical = 3

[node name="ShipyardList" type="VBoxContainer" parent="Margin/VBox/ShipTabs/Shipyard"]
unique_name_in_owner = true
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="Modules" type="ScrollContainer" parent="Margin/VBox/ShipTabs"]
size_flags_vertical = 3

[node name="ModulesList" type="VBoxContainer" parent="Margin/VBox/ShipTabs/Modules"]
unique_name_in_owner = true
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="Commissions" type="ScrollContainer" parent="Margin/VBox/ShipTabs"]
size_flags_vertical = 3

[node name="CommissionsList" type="VBoxContainer" parent="Margin/VBox/ShipTabs/Commissions"]
unique_name_in_owner = true
