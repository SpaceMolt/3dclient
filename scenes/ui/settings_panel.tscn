[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/settings_panel.gd" id="1"]

[node name="SettingsPanel" type="CanvasLayer"]
layer = 10
script = ExtResource("1")

[node name="Panel" type="Panel" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="TopBar" type="HBoxContainer" parent="Panel"]
offset_left = 60.0
offset_top = 8.0
offset_right = 400.0
offset_bottom = 38.0
theme_override_constants/separation = 12

[node name="CloseButton" type="Button" parent="Panel/TopBar"]
text = "X"
theme_override_font_sizes/font_size = 14

[node name="TitleLabel" type="Label" parent="Panel/TopBar"]
text = "Settings"
theme_override_font_sizes/font_size = 16
modulate = Color(0.4, 0.8, 1.0, 1)

[node name="ScrollContainer" type="ScrollContainer" parent="Panel"]
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 60.0
offset_top = 50.0
offset_right = -60.0
offset_bottom = -20.0

[node name="Content" type="VBoxContainer" parent="Panel/ScrollContainer"]
